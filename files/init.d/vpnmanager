#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/vpnmand
CONFIG=/etc/vpnmanager/config.json
STATE_DIR=/var/lib/vpnmanager

start_service() {
	procd_open_instance
	# Демон работает в foreground; фоновый режим не используется.
	procd_set_param command "$PROG" -config "$CONFIG" -state-dir "$STATE_DIR" -log-level info
	# Утверждённая политика перезапуска (№07 §7).
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONFIG"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "vpnmanager"
}
