# Стартовая конфигурация пакета (UCI), предусмотренная планом №44 §2.3.
# Этап 1: только имя экземпляра и включение. Параметры добавляются вместе с
# потребителями; демон этапа 1 читает JSON-конфигурацию и этот файл не
# интерпретирует. Значения не меняют ни сеть, ни firewall.

config vpnmanager 'main'
	option enabled '0'
